# Required
ANTHROPIC_API_KEY=your_anthropic_api_key

# KakaoTalk 나에게 보내기
# Kakao Developers에서 앱 등록 후 REST API 키로 발급한 사용자 Access Token
KAKAO_ACCESS_TOKEN=your_kakao_user_access_token

# Optional: news API keys (없으면 RSS만 사용)
FINNHUB_API_KEY=your_finnhub_api_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# Scan interval in minutes (default: 15)
SCAN_INTERVAL_MINUTES=15

# Telegram bot (for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Instagram Graph API (숏폼 업로드)
# Facebook Developers에서 Instagram Business 계정 연동 후 발급
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# YouTube Data API v3 (숏폼 업로드)
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_OAUTH_TOKEN=your_youtube_oauth_token  # OAuth2 access token

# ElevenLabs TTS (optional, edge-tts 무료 사용 가능)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Content generation settings
CONTENT_SCHEDULE_TIME=17:00
CONTENT_OUTPUT_DIR=output
CONTENT_TOP_N=3
